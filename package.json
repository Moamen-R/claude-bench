{
  "name": "claude-bench",
  "version": "1.1.0",
  "description": "Production-grade, open-source CLI bootstrapper for Claude Code and Claude Desktop tailored across 13 professional fields",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "claude-bench": "./dist/index.js",
    "create-claude-env": "./dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "src/registry/registry.seed.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moamen-R/claude-bench.git"
  },
  "bugs": {
    "url": "https://github.com/Moamen-R/claude-bench/issues"
  },
  "homepage": "https://github.com/Moamen-R/claude-bench#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "omniroute",
    "agent",
    "mcp",
    "skills",
    "cli"
  ],
  "author": "Mo'men Refaey",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "picocolors": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
